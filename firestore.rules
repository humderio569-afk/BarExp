rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCategory(data) {
      return data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidProduct(data) {
      return data.id is string
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.category is string
        && data.price is number && data.price >= 0
        && data.stock is number
        && data.active is bool;
    }

    function isValidSale(data) {
      return data.id is string
        && data.receiptNumber is string
        && data.total is number && data.total >= 0
        && data.paymentMethod is string
        && data.cashierName is string
        && data.timestamp is string;
    }

    function isValidExpense(data) {
      return data.id is string
        && data.category is string
        && data.description is string && data.description.size() <= 500
        && data.amount is number && data.amount >= 0
        && data.date is string
        && data.paymentMethod is string;
    }

    function isValidTab(data) {
      return data.id is string
        && data.tableName is string
        && data.status is string;
    }

    function isValidStockLog(data) {
      return data.id is string
        && data.productId is string
        && data.productName is string
        && data.type is string
        && data.quantity is number
        && data.timestamp is string;
    }

    function isValidSettings(data) {
      return data.barName is string && data.barName.size() > 0
        && data.currency is string;
    }

    function isValidUser(data) {
      return data.uid is string
        && data.email is string && data.email.size() > 0
        && data.role is string
        && data.status is string;
    }

    function isValidAuditLog(data) {
      return data.id is string
        && data.action is string
        && data.details is string
        && data.userId is string
        && data.timestamp is string;
    }

    function isValidChatSession(data) {
      return data.id is string
        && data.userId is string
        && data.title is string
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isValidCompany(data) {
      return data.id is string
        && data.code is string && data.code.size() > 0 && data.code.size() <= 20
        && data.name is string && data.name.size() > 0 && data.name.size() <= 150
        && data.managerName is string && data.managerName.size() > 0
        && data.adminEmail is string && data.adminEmail.size() > 0
        && data.status is string;
    }

    function isValidPreRegistration(data) {
      return data.id is string
        && data.companyId is string
        && data.companyCode is string
        && data.name is string && data.name.size() > 0
        && data.email is string && data.email.size() > 0
        && data.role is string
        && data.status is string;
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /_connection_test/{docId} {
      allow read, write: if true;
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if true;
      allow create, update: if isValidId(companyId) && isValidCompany(incoming());
      allow delete: if isValidId(companyId);
    }

    // Pre-registrations collection
    match /pre_registrations/{preRegId} {
      allow read: if true;
      allow create, update: if isValidId(preRegId) && isValidPreRegistration(incoming());
      allow delete: if isValidId(preRegId);
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Sales collection
    match /sales/{saleId} {
      allow read: if true;
      allow create, update: if isValidId(saleId) && isValidSale(incoming());
      allow delete: if isValidId(saleId);
    }

    // Expenses collection
    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidId(expenseId) && isValidExpense(incoming());
      allow delete: if isValidId(expenseId);
    }

    // Tabs collection
    match /tabs/{tabId} {
      allow read: if true;
      allow create, update: if isValidId(tabId) && isValidTab(incoming());
      allow delete: if isValidId(tabId);
    }

    // Stock logs collection
    match /stockLogs/{logId} {
      allow read: if true;
      allow create, update: if isValidId(logId) && isValidStockLog(incoming());
      allow delete: if isValidId(logId);
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidSettings(incoming());
      allow delete: if isValidId(settingId);
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if isValidId(logId);
    }

    // Chat sessions collection (scoped to user)
    match /chat_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isValidId(sessionId) && isValidChatSession(incoming());
      allow delete: if isValidId(sessionId);
    }
  }
}
